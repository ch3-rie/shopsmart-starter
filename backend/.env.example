DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Server-only Google Gemini API key. Leave it blank to use catalog rules.
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
# Never place this key in frontend environment variables, logs, or source control.
GEMINI_API_KEY=

# Optional. Current Flash model for new Gemini projects. Override if Google renames it.
# Model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Optional provider timeout in milliseconds. The server clamps this between 1000 and 15000.
GEMINI_TIMEOUT_MS=8000
