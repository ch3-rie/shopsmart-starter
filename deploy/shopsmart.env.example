# Copy to /home/ubuntu/shopsmart.env on the EC2 host, then: chmod 600 ~/shopsmart.env
# This file holds SECRETS. Never commit it, paste it in chat, or show it in a screenshot.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1
# Exact HTTPS origin of the site, no trailing slash, no path.
FRONTEND_URL=https://YOUR-HOST
# Database password: generate with  openssl rand -hex 24  (hex avoids URL-escaping problems)
DATABASE_URL="postgresql://shopsmart_app:PASTE-GENERATED-PASSWORD@localhost:5432/shopsmart?schema=public"
# Leave blank to use the labeled catalog-rules answers (no paid AI needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=8000
